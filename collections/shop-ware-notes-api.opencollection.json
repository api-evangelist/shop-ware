{
  "opencollection": "1.0.0",
  "info": {
    "name": "API V1 API Partners Notes API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Partner-Id",
      "value": "{{X-Api-Partner-Id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of all notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tenants/:tenant_id/notes",
            "params": [
              {
                "name": "tenant_id",
                "value": "1",
                "type": "path"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "30",
                "type": "query"
              },
              {
                "name": "updated_after",
                "value": "2022-10-24T12%3A00%3A00%2B08%3A00",
                "type": "query",
                "description": "Filter response to only include records updated after a given time"
              },
              {
                "name": "repair_order_id",
                "value": "1",
                "type": "query",
                "description": "Filter response to include only notes related to specified repair order."
              }
            ]
          },
          "docs": "Get a list of all notes"
        },
        {
          "info": {
            "name": "Create a note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/tenants/:tenant_id/notes",
            "params": [
              {
                "name": "tenant_id",
                "value": "1",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a note"
        },
        {
          "info": {
            "name": "Get a specific note by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tenants/:tenant_id/notes/:id",
            "params": [
              {
                "name": "tenant_id",
                "value": "1",
                "type": "path"
              },
              {
                "name": "id",
                "value": "1",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific note by ID"
        },
        {
          "info": {
            "name": "Update a specific note",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/tenants/:tenant_id/notes/:id",
            "params": [
              {
                "name": "tenant_id",
                "value": "1",
                "type": "path"
              },
              {
                "name": "id",
                "value": "1",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific note"
        }
      ]
    }
  ],
  "bundled": true
}