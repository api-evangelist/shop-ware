          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a webhook"
        },
        {
          "info": {
            "name": "Get a webhook by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/webhooks/:id",
