{
  "opencollection": "1.0.0",
  "info": {
    "name": "API V1 API Partners Webhooks API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Partner-Id",
      "value": "{{X-Api-Partner-Id}}",
      "placement": "header"
    }
  },
  "items": [
