              {
                "name": "id",
                "value": "1",
                "type": "path"
              }
            ]
          },
          "docs": "Get a webhook by ID"
        },
        {
          "info": {
            "name": "Update a webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a webhook"
        },
        {
          "info": {
            "name": "Delete a webhook by ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a webhook by ID"
        }
      ]
    }
